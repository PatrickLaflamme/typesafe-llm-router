# Copy to `.env` locally (never commit real keys).
TYPESAFE_API_KEY=
# Optional — defaults to https://api.typesafe.ai
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# CURSOR_API_KEY=
# Databricks Unity AI Gateway (ModelProvider)
# DATABRICKS_HOST=https://adb-xxxxxxxxxxxx.azuredatabricks.net
# DATABRICKS_TOKEN=
# Optional: JSON ModelInfo[] or comma-separated FQNs
# DATABRICKS_AI_GATEWAY_MODELS=system.ai.claude-sonnet-4-5,system.ai.claude-opus-4-6
# Optional: switches to /ai-gateway/openai/v1 + header
# DATABRICKS_MODEL_PROVIDER_SERVICE=main.default.openai_prod
