{"version": 2, "width": 80, "height": 24, "timestamp": 1789650018, "idle_time_limit": 3.0, "env": {"SHELL": "/bin/bash", "TERM": "dumb"}, "title": "Databricks AI Gateway demo (offline mock)"}
[1.006959, "o", "\r\n╔══════════════════════════════════════════════════════════════════╗\r\n║  typesafe-llm-router — Databricks AI Gateway demo              ║\r\n╚══════════════════════════════════════════════════════════════════╝\r\n\r\n  Mode: OFFLINE mock (CLI path + Gateway shape; no live workspace)\r\n"]
[2.208128, "o", "  Auth story (what Patrick runs for real):\r\n"]
[3.009667, "o", "    $ databricks auth login --host https://<workspace-url>\r\n"]
[4.511179, "o", "    $ databricks auth env     # → DATABRICKS_HOST\r\n"]
[5.712746, "o", "    $ databricks auth token   # → access_token + expiry\r\n"]
[9.328092, "o", "\r\n  Mock Gateway: http://127.0.0.1:18765  (mlflow chat completions)\r\n  Mock CLI:     $DATABRICKS_CLI → auth env / auth token\r\n"]
[11.529232, "o", "\r\n\r\n╔══════════════════════════════════════════════════════════════════╗\r\n║  CLI auth probe (provider uses these under the hood)             ║\r\n╚══════════════════════════════════════════════════════════════════╝\r\n\r\n"]
[13.730742, "o", "$ \"$DATABRICKS_CLI\" auth env\r\n"]
[14.334546, "o", "{\r\n"]
[14.655762, "o", "  \"env\": {\r\n"]
[14.977398, "o", "    \"DATABRICKS_HOST\": \"http://127.0.0.1:18765\",\r\n"]
[15.298707, "o", "    \"DATABRICKS_CONFIG_PROFILE\": \"DEFAULT\"\r\n"]
[15.620221, "o", "  }\r\n"]
[15.941727, "o", "}\r\n"]
[19.764647, "o", "\r\n$ \"$DATABRICKS_CLI\" auth token   # token redacted in demo narration\r\n"]
[20.381551, "o", "{\r\n  \"access_token\": \"mock-dat\\u2026demo\",\r\n  \"token_type\": \"Bearer\",\r\n  \"expiry\": \"2099-01-01T00:00:00Z\"\r\n}\r\n"]
[23.885504, "o", "\r\n\r\n╔══════════════════════════════════════════════════════════════════╗\r\n║  Default list_models() catalog (ids + baked-in $/MTok)           ║\r\n╚══════════════════════════════════════════════════════════════════╝\r\n\r\n"]
[26.08832, "o", "  id                                         tier         in $/M   out $/M\r\n"]
[26.409345, "o", "  system.ai.databricks-gpt-oss-120b          T-small      0.10     0.40\r\n"]
[26.730558, "o", "  system.ai.claude-sonnet-4-5                T-mid        3.00    15.00\r\n"]
[27.052186, "o", "  system.ai.claude-opus-4-6                  T-frontier  15.00    75.00\r\n"]
[30.877091, "o", "\r\n\r\n╔══════════════════════════════════════════════════════════════════╗\r\n║  Route short-classify → Databricks ModelProvider               ║\r\n╚══════════════════════════════════════════════════════════════════╝\r\n\r\n"]
[33.078672, "o", "Session: examples/a_e/b_short_classify_databricks.json\r\n"]
[33.880114, "o", "Command:\r\n"]
[34.381369, "o", "  cargo run -- demo --session examples/a_e/b_short_classify_databricks.json --model-provider databricks\r\n"]
[37.882851, "o", "\r\nAlso equivalent:\r\n"]
[38.284323, "o", "  cargo run -- route --session examples/a_e/b_short_classify_databricks.json --model-provider databricks --execute\r\n"]
[40.485739, "o", "\r\n"]
[40.492542, "o", "========================================\r\n"]
[40.814057, "o", "  typesafe-llm-router — morning demo\r\n"]
[41.135483, "o", "========================================\r\n"]
[41.457262, "o", "\r\n"]
[41.579016, "o", "=== INPUT ===\r\n"]
[43.780365, "o", "task_class: ShortClassify\r\n"]
[44.10176, "o", "current_model: system.ai.databricks-gpt-oss-120b\r\n"]
[44.423113, "o", "allowlist: [\"system.ai.databricks-gpt-oss-120b\", \"system.ai.claude-sonnet-4-5\", \"system.ai.claude-opus-4-6\"]\r\n"]
[44.744396, "o", "session:\r\n"]
[45.06583, "o", "  [0] system: You label support tickets with exactly one of: billing | bug | feature | other. Reply with one label only. Shared classifier preamble used on every ticket (~400 tokens of policy examples omitted here).\r\n"]
[45.387176, "o", "  [1] user: I was charged twice for my annual plan and the portal still shows active. Please fix.\r\n"]
[45.708783, "o", "\r\n"]
[45.830242, "o", "=== PROCESS ===\r\n"]
[48.03154, "o", "  → ModelProvider.list_models (databricks-ai-gateway) → Choice allowlist + $/MTok\r\n"]
[51.533078, "o", "  → System One Choice route (StubTypesafeClient / jev-latest shape)\r\n"]
[51.854795, "o", "  → ModelProvider = databricks-ai-gateway (chosen_model id == complete model_id)\r\n"]
[52.176225, "o", "  → ModelProvider.complete (databricks-ai-gateway)\r\n"]
[52.497726, "o", "  → chosen_model = system.ai.databricks-gpt-oss-120b (T-small)\r\n"]
[55.999222, "o", "  → ModelProvider.complete → model_output ready\r\n"]
[56.320741, "o", "  → score: pending/enqueued (job score_1789650059078196169) — async worker later; NOT on hot path\r\n"]
[56.641921, "o", "  → primary_reason = continue_current\r\n"]
[56.963448, "o", "\r\n"]
[57.084996, "o", "=== OUTPUT ===\r\n"]
[59.286215, "o", "selected_model: system.ai.databricks-gpt-oss-120b [T-small]\r\n"]
[64.787795, "o", "primary_reason: continue_current\r\n"]
[68.289616, "o", "model_output:\r\n"]
[73.790985, "o", "billing\r\n"]
[74.112466, "o", "\r\n"]
[74.233754, "o", "=== OUTCOME META ===\r\n"]
[76.435336, "o", "scores_status: Pending\r\n"]
[76.756898, "o", "(drain later: cargo run -- drain-score-queue --stub)\r\n"]
[77.078221, "o", "\r\n"]
[82.702828, "o", "\r\n╔══════════════════════════════════════════════════════════════════╗\r\n║  RESULT — Patrick lock check                                   ║\r\n╚══════════════════════════════════════════════════════════════════╝\r\n\r\n  Choice allowlist  = Databricks list_models() ids (with prices on ModelInfo)\r\n"]
[84.204586, "o", "  chosen_model      = id passed to ModelProvider.complete (no remap)\r\n"]
[85.70595, "o", "  Score             = async / pending (not on hot path)\r\n"]
[89.207368, "o", "\r\n  Offline mock complete. For live Gateway:\r\n"]
[90.208792, "o", "    databricks auth login --host https://<workspace-url>\r\n"]
[91.41003, "o", "    cargo run -- demo --session examples/a_e/b_short_classify_databricks.json --model-provider databricks\r\n"]
[92.611746, "o", "    # or:  … route … --model-provider databricks --execute\r\n"]
[96.613124, "o", "\r\nDone.\r\n"]
